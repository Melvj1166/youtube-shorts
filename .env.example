# PodShorts Configuration
# Copy this file to .env and fill in values

# Models
WHISPER_MODEL=large-v3
WHISPER_COMPUTE_TYPE=int8
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Pipeline
TOP_N_SHORTS=5
MIN_SHORT_DURATION=20
MAX_SHORT_DURATION=60
ENABLE_DIARIZATION=false

# Paths
CACHE_DIR=./cache
OUTPUT_DIR=./output

# Memory (optional)
GRAPHIFY_NAMESPACE=podshorts
# GRAPHIFY_ENDPOINT=http://localhost:8080
# GRAPHIFY_API_KEY=

# Behavior
FORCE_RERUN=false
LOG_LEVEL=INFO
