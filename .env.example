# PodShorts configuration — copy to .env and adjust

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Whisper
WHISPER_MODEL=large-v3
WHISPER_COMPUTE_TYPE=int8

# Pipeline
TOP_N_SHORTS=5
MIN_SHORT_DURATION=20
MAX_SHORT_DURATION=60
ENABLE_DIARIZATION=false

# Paths
CACHE_DIR=./cache
OUTPUT_DIR=./output
FACE_DETECTOR_MODEL=./models/blaze_face_short_range.tflite

# Graphify memory (optional)
# GRAPHIFY_NAMESPACE=podshorts
# GRAPHIFY_ENDPOINT=
# GRAPHIFY_API_KEY=

# Behavior
LOG_LEVEL=INFO
